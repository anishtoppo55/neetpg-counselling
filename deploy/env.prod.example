# Copy to deploy/.env.prod and fill in. That file is git-ignored: it holds the database password.
#   cp deploy/env.prod.example deploy/.env.prod
# ./lightsail.sh reads it and uploads it to the box as ~/neetpg/.env

# ----------------------------------------------------------------- public hostname
# The name the dashboard is served on. Caddy obtains a Let's Encrypt certificate for exactly this name,
# so it must already resolve to the instance's static IP before the first start.
# A free DuckDNS name works: register at https://duckdns.org, then point it at the Lightsail static IP.
SITE_HOST=changeme.duckdns.org

# An email address turns on Let's Encrypt (expiry warnings go here).
# Use the literal word `internal` for a local smoke test – Caddy then issues a self-signed certificate.
TLS_EMAIL=internal

# ----------------------------------------------------------------- database
POSTGRES_DB=neetpg
POSTGRES_USER=neetpg
# Generate one: openssl rand -base64 24 | tr -d '/+=' | cut -c1-28
POSTGRES_PASSWORD=changeme
DB_POOL_MAX=3

# ----------------------------------------------------------------- deployment target (optional)
# Saves typing --host / --key on every ./lightsail.sh command.
# Lightsail's Ubuntu blueprints log in as `ubuntu`; use the instance's STATIC IP.
# SSH_HOST=ubuntu@13.200.0.1
# SSH_KEY=~/.ssh/LightsailDefaultKey-ap-south-1.pem
