# ---------------------------------------------------------------- secrets
# This repository is public. Credentials are excluded by pattern rather than by name, so a new file
# (.env.local, a cloud key downloaded to the repo root) cannot be committed by accident.
.env
.env.*
!.env.example
deploy/.deploy-target

# private keys and certificate material, in every common flavour
*.pem
*.key
*.p12
*.pfx
*.ppk
*.jks
*.keystore
id_rsa*
id_ed25519*

# cloud service-account files, which are ordinary-looking JSON and easy to drop in by mistake
*credentials*.json
*service-account*.json
*serviceaccount*.json
*-key.json
gha-creds-*.json
.aws/
.gcloud/

# ---------------------------------------------------------------- build and cache
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.next/
*.tsbuildinfo
.scratch/

# ---------------------------------------------------------------- generated data
data/cache/
data/reports/

# database dumps: these contain the full dataset and are produced by `lightsail.sh data`.
# NOT a blanket *.sql rule - pipeline/migrations/*.sql is source and must stay tracked.
*.sql.gz
*.dump
neetpg-backup*

# official source PDFs: ~150 MB, re-downloadable with scripts/fetch_mcc_documents.py
# (manifest.csv is kept, so provenance stays in git)
data/raw/**/*.pdf
